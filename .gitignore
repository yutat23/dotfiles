# =============================================================================
# Git除外設定
# =============================================================================

# 個人用設定ファイル（必要に応じてコメントアウトを解除）
# .bashrc
# .zshrc

# プロキシ設定（個人情報を含む可能性があるため）
setProxy.sh

# Vim関連
.netrwhist
*.swp
*.swo
*~
.vim/undo/
.vim/plugged/

# バックアップファイル
*.backup.*
*.bak

# OS固有ファイル
.DS_Store
Thumbs.db
desktop.ini

# 一時ファイル
*.tmp
*.log

# ローカル設定
local.sh

# =============================================================================
# ~/.config 配下のアプリ生成データ
# =============================================================================

# 端末・セッション固有データ
.config/Futu-Mac/
.config/raycast/
.config/herdr/session.json
.config/gh/hosts.yml

# fishプラグインの生成物と端末固有状態
.config/fish/completions/
.config/fish/conf.d/
.config/fish/functions/
.config/fish/themes/
.config/fish/fish_variables

# エディタが生成するローカルデータ
.config/nvim/.neoconf.json
.config/zed/conversations/
.config/zed/prompts/
.config/zed/themes/
